# PostgreSQL connection string used by Prisma and the app.
DATABASE_URL="postgresql://eventsync:eventsync_password@localhost:5433/eventsync?schema=public"

# HTTP port the Nest app listens on.
PORT=4000

# Secret used to sign JWT access/refresh tokens.
JWT_SECRET="change-me"

# --- Stripe Checkout (optional) ---------------------------------------------
# Leave STRIPE_SECRET_KEY unset to use the in-process mock checkout gateway.
# When it IS set, all three of the values below are required (the app fails to
# start otherwise). Use test-mode keys from the Stripe dashboard.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_CURRENCY=usd
# STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success
# STRIPE_CANCEL_URL=http://localhost:3000/checkout/cancel

# Signing secret used to verify inbound Stripe webhook signatures. Required for
# POST /payments/webhook/stripe to accept events (the endpoint reports itself as
# unavailable without it). Get it from `stripe listen` or the dashboard endpoint.
# STRIPE_WEBHOOK_SECRET=whsec_...
